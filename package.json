{
  "name": "foxhollow-daily-games",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test games/tests/*.test.mjs",
    "test:browser": "node games/tests/browser.mjs && node games/tests/newgames-browser.mjs && node games/tests/wordbridge-browser.mjs && node games/tests/daily-rollover-browser.mjs && node games/tests/eight-browser.mjs",
    "dev": "python3 games/scripts/serve.py",
    "lint": "eslint games/src games/tests eslint.config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "playwright": "^1.56.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.0"
  }
}
